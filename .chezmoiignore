# Repo-level files. These live in the dotfiles repo but must never be
# installed into $HOME.
#
# Patterns match with doublestar against the TARGET path and are anchored at
# the destination root -- this is NOT gitignore semantics. So `README.md` here
# means ~/README.md only; it does not affect ~/.config/nvim/docs/keymaps.md.
#
# Source entries beginning with "." (.github/, .gitignore) are ignored by
# chezmoi automatically and need no entry here.
README.md
AGENTS.md
GLOSSARY.md
GLOSSARY-MAP.md
Brewfile
LICENSE
scripts/
settings.toml
themes/
themes-local/
docs/

# The apply hook owns checkout symlinks here; never import links, payloads or locks.
.agents/
# Retired skill snapshots stay unmanaged; never import the old cache.
.cache/dotfiles/pi-skills/

# Generated or private files at $HOME. chezmoi only tracks what is
# explicitly added, but these are listed so an accidental
# `chezmoi add ~/.zshrc` (or `chezmoi add ~`) cannot sweep them in.
# ~/.zsh/secrets.zsh holds API keys and tokens — a SECRET, never commit it.
.zsh_history
.zcompdump*
.zsh/secrets.zsh

# Only the SSH address book is managed, regardless of credential filenames.
# private_ source prefixes are permissions, NOT encryption. Keep the parent
# directory traversable so hosts.conf can still be imported and applied.
.ssh/**
!.ssh
!.ssh/hosts.conf

# Herdr desktop preferences + generated palettes only. Do not import shipped
# mods/layouts/themes, keys, runtime state, machine identities or core payloads.
.config/herdr-app/**
!.config/herdr-app
!.config/herdr-app/settings.json
!.config/herdr-app/themes
!.config/herdr-app/themes/dotfiles-light.json
!.config/herdr-app/themes/dotfiles-dark.json
.config/herdr-core
.local/state/herdr-core
.local/share/herdr-core
.local/bin/hc
.local/bin/herdr-core
.local/bin/herdr-app
# Ignore the old directory itself, not its children: a child ignore would
# also suppress the exact legacy config removal in .chezmoiremove.
.config/herdr

# Same idea for the pi coding agent (~/.pi/agent/): auth.json (written by
# /login) holds a copy of the Z.ai API key and is a SECRET, models-store.json
# is a catalog cache pi refetches from the provider, sessions/ is transcripts,
# npm/ is pi's installed-package tree (the payload behind settings.json's
# "packages" entries, owned by `pi install`), and the permission system's
# logs/ is runtime output. An accidental `chezmoi add ~/.pi` must not sweep
# any of them into the repo.
.pi/agent/auth.json
.pi/agent/models-store.json
.pi/agent/sessions
.pi/agent/npm
.pi/agent/extensions/pi-permission-system/logs
