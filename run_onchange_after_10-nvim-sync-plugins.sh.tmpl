#!/usr/bin/env bash
# Keep installed plugins and treesitter parsers in step with the declared lists.
#
# The hashes below make chezmoi re-run this script whenever the plugin spec, the
# lockfile, or the parser list changes, so editing any of them and running
# `chezmoi apply` is all it takes to converge any machine.
#
# lazy.lua hash:        {{ include "dot_config/nvim/lua/bruce/lazy.lua" | sha256sum }}
# lazy-lock.json hash:  {{ include "dot_config/nvim/lazy-lock.json" | sha256sum }}
# treesitter.lua hash:  {{ include "dot_config/nvim/lua/bruce/plugins/treesitter.lua" | sha256sum }}

set -euo pipefail

command -v nvim >/dev/null 2>&1 || { echo "nvim not installed; skipping plugin sync" >&2; exit 0; }

# `restore` installs anything missing and checks every plugin out at the commit
# recorded in lazy-lock.json, so all machines end up on identical versions.
# Use `:Lazy update` interactively to move forward; that rewrites the lockfile.
echo "syncing plugins (lazy.nvim, pinned to lazy-lock.json)..."
nvim --headless "+Lazy! restore" +qa

# Neovim installs LSP servers and treesitter parsers asynchronously on startup,
# which a headless run would exit before finishing. Drive both synchronously.
echo "installing LSP servers..."
nvim --headless -c 'MasonInstall python-lsp-server' -c 'qa!' >/dev/null 2>&1 || true

echo "installing treesitter parsers..."
nvim --headless \
    -c 'lua require("nvim-treesitter").install(require("bruce.plugins.treesitter").ensure_installed):wait(600000)' \
    -c 'qa!' >/dev/null 2>&1 || true

echo "plugin sync complete"
