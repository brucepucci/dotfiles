[user]
	name = Bruce Pucci
	email = brucepucci@gmail.com
[init]
	defaultBranch = main
[core]
	pager = delta-theme
[interactive]
	diffFilter = delta-theme --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = none
	{{- /* diffs follow the terminal's own palette; the delta-theme wrapper
	   decides light/dark per invocation; this covers a bare `delta` typed
	   by hand, which stays dark -- the default look */}}
	# Appearance (light/dark + syntax theme) is decided per invocation by the
	# delta-theme wrapper in ~/.local/bin; the line above only covers a bare
	# `delta` typed by hand, which stays dark -- the default look.
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true
{{- $gh := lookPath "gh" }}
{{ if $gh }}
# HTTPS auth for this private repo, provided by gh. `gh auth setup-git`
# writes exactly this pair into ~/.gitconfig on a new machine -- but this
# repo owns that file, so apply would wipe it; rendered here instead, with
# gh's path resolved at apply time. The empty value first resets helpers
# inherited from lower scopes (Homebrew's system-level osxkeychain): the
# keychain cannot serve agent/SSH contexts, where git aborts with
# "could not read Username for 'https://github.com'".
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{ end -}}
