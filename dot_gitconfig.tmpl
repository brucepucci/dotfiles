[user]
	name = Bruce Pucci
	email = brucepucci@gmail.com
[init]
	defaultBranch = main
[core]
	pager = delta-theme
[interactive]
	diffFilter = delta-theme --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = none
	{{- /* diffs follow the terminal's own palette; the delta-theme wrapper
	   decides light/dark per invocation; this covers a bare `delta` typed
	   by hand, which stays dark -- the default look */}}
	# Appearance (light/dark + syntax theme) is decided per invocation by the
	# delta-theme wrapper in ~/.local/bin; the line above only covers a bare
	# `delta` typed by hand, which stays dark -- the default look.
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true
