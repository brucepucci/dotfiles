{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
{{- /* GENERATED from the palette settings (.chezmoidata/palette.toml) and
     the light theme's roles, resolved live from Ghostty's catalog by
     scripts/ghostty-theme.py -- do not hand-edit; change the theme name in
     the settings and `chezmoi apply`. The file name
     is stable across theme changes; entries referencing the theme's own
     vars stay literal (that mapping is Layer 3, decided per surface). */ -}}
{{ $t := output (joinPath .chezmoi.sourceDir "scripts" "ghostty-theme.py") .palette.light_theme | trim | fromJson }}
  "name": "dotfiles-light",
  "vars": {
    "bg": "{{ $t.roles.bg }}",
    "bgDeep": "{{ $t.roles.bg_deep }}",
    "surface": "{{ $t.roles.surface }}",
    "fg": "{{ $t.roles.fg }}",
    "fgSoft": "{{ $t.roles.fg_soft }}",
    "fgBright": "{{ $t.roles.fg_bright }}",
    "grey": "{{ $t.roles.grey }}",
    "greyDim": "{{ $t.roles.grey_dim }}",
    "red": "{{ $t.roles.red }}",
    "orange": "{{ $t.roles.orange }}",
    "yellow": "{{ $t.roles.yellow }}",
    "green": "{{ $t.roles.green }}",
    "aqua": "{{ $t.roles.aqua }}",
    "blue": "{{ $t.roles.blue }}",
    "purple": "{{ $t.roles.purple }}"
  },
  "colors": {
    "accent": "blue",
    "border": "greyDim",
    "borderAccent": "blue",
    "borderMuted": "surface",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "grey",
    "dim": "greyDim",
    "text": "",
    "thinkingText": "grey",
    "selectedBg": "bg",
    "scrollbarThumb": "surface",
    "searchMatchBg": "surface",
    "searchMatchText": "",
    "userMessageBg": "bg",
    "userMessageText": "",
    "customMessageBg": "bg",
    "customMessageText": "",
    "customMessageLabel": "blue",
    "toolPendingBg": "bg",
    "toolSuccessBg": "{{ $t.roles.tint_green }}",
    "toolErrorBg": "{{ $t.roles.tint_red }}",
    "toolTitle": "fg",
    "toolOutput": "",
    "mdHeading": "yellow",
    "mdLink": "blue",
    "mdLinkUrl": "grey",
    "mdCode": "aqua",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "greyDim",
    "mdQuote": "fg",
    "mdQuoteBorder": "greyDim",
    "mdHr": "greyDim",
    "mdListBullet": "aqua",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "grey",
    "syntaxComment": "{{ $t.roles.grey_neutral }}",
    "syntaxKeyword": "red",
    "syntaxFunction": "blue",
    "syntaxVariable": "orange",
    "syntaxString": "green",
    "syntaxNumber": "purple",
    "syntaxType": "yellow",
    "syntaxOperator": "blue",
    "syntaxPunctuation": "fg",
    "thinkingOff": "{{ $t.roles.grey_soft }}",
    "thinkingMinimal": "greyDim",
    "thinkingLow": "grey",
    "thinkingMedium": "aqua",
    "thinkingHigh": "yellow",
    "thinkingXhigh": "orange",
    "thinkingMax": "red",
    "bashMode": "orange"
  }
}
