{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
{{- /* GENERATED from settings.toml (the repo root) and Ghostty's catalog by
     scripts/ghostty-theme.py -- do not hand-edit; change the theme name in
     settings.toml and `chezmoi apply`. The file name is stable across theme
     changes.

     The vars ride TERMINAL-INDEXED colors, not hexes: bg/fg are the
     terminal defaults, the six accents are their exact palette slots
     (derive_roles maps them from those very entries), grey is slot 8 --
     the theme author's own muted color. pi renders these as 256-color
     indices, and 0-15 are mapped by the VIEWING terminal through its own
     palette, so over SSH pi follows the terminal you are sitting at, not
     the machine that rendered this file (the zsh prompt works the same
     way). Locally this is pixel-identical to the old hexes: same theme on
     both sides of the glass. Shades with no honest slot (surface, dim
     grey, the blended orange) ride the xterm cube -- fixed by spec, every
     terminal renders 16-255 identically. The two tool tints stay
     live-derived hexes: the cube has no muted olive/rust, and nearest-
     mapping them collapses the success/error cue into two greys. (A
     sparse custom theme whose author left palette slots unset emits
     those roles' hexes instead of the indices -- see pi_vars.)

     colors (Layer 3) reference only the vars above; that mapping is
     decided here, per surface. */ -}}
{{ $lightName := output (joinPath .chezmoi.sourceDir "scripts" "ghostty-theme.py") "--setting" "light_theme" | trim -}}
{{ $pi := output (joinPath .chezmoi.sourceDir "scripts" "ghostty-theme.py") "--pi" $lightName | trim }}
  "name": "dotfiles-light",
  "vars": {{ $pi }},
  "colors": {
    "accent": "blue",
    "border": "grey_dim",
    "borderAccent": "blue",
    "borderMuted": "surface",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "grey",
    "dim": "grey_dim",
    "text": "",
    "thinkingText": "grey",
    "selectedBg": "bg",
    "scrollbarThumb": "surface",
    "searchMatchBg": "surface",
    "searchMatchText": "",
    "userMessageBg": "surface",
    "userMessageText": "",
    "customMessageBg": "bg",
    "customMessageText": "",
    "customMessageLabel": "blue",
    "toolPendingBg": "bg",
    "toolSuccessBg": "tint_green",
    "toolErrorBg": "tint_red",
    "toolTitle": "fg",
    "toolOutput": "",
    "mdHeading": "yellow",
    "mdLink": "blue",
    "mdLinkUrl": "grey",
    "mdCode": "aqua",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "grey_dim",
    "mdQuote": "fg",
    "mdQuoteBorder": "grey_dim",
    "mdHr": "grey_dim",
    "mdListBullet": "aqua",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "grey",
    "syntaxComment": "grey_neutral",
    "syntaxKeyword": "red",
    "syntaxFunction": "blue",
    "syntaxVariable": "orange",
    "syntaxString": "green",
    "syntaxNumber": "purple",
    "syntaxType": "yellow",
    "syntaxOperator": "blue",
    "syntaxPunctuation": "fg",
    "thinkingOff": "grey_soft",
    "thinkingMinimal": "grey_dim",
    "thinkingLow": "grey",
    "thinkingMedium": "aqua",
    "thinkingHigh": "yellow",
    "thinkingXhigh": "orange",
    "thinkingMax": "red",
    "bashMode": "orange"
  }
}
