# ~/.zprofile — login-shell PATH, read once by zsh login shells (Ghostty,
# Terminal.app, iTerm2, and anyone SSH-ing into this machine) before ~/.zshrc.
# Interactive-shell setup — prompt, aliases, completion, secrets — lives in
# ~/.zshrc.

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Personal, machine-local scripts (not Homebrew-managed). delta-theme lives
# here -- the appearance-aware delta wrapper used by git's pager and lazygit.
path+=(~/.local/bin)
export PATH
