# ~/.zprofile — login-shell PATH, read once by zsh login shells (Ghostty,
# Terminal.app, iTerm2, and anyone SSH-ing into this machine) before ~/.zshrc.
# Interactive-shell setup — prompt, aliases, completion, secrets — lives in
# ~/.zshrc.

# Homebrew, wherever it landed: Apple Silicon, Intel Mac, or Linuxbrew.
# The ladder is a runtime probe, not a template -- one file that is correct
# on every machine this repo is checked out on.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x $HOME/.linuxbrew/bin/brew ]]; then
  eval "$($HOME/.linuxbrew/bin/brew shellenv)"
fi

# Personal, machine-local scripts (not Homebrew-managed). delta-theme lives
# here -- the appearance-aware delta wrapper used by git's pager and lazygit.
path+=(~/.local/bin)
export PATH
