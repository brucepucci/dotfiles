# ~/.config/herdr/config.toml -- GENERATED by chezmoi; do not hand-edit.
# Rendered from settings.toml (repo root) + the vendored theme mirror via
# scripts/theme.py at apply time, like every other surface this repo
# manages. herdr's own state (herdr-server.log, .plugins.lock) shares this
# directory -- chezmoi leaves those alone.
#
# Updates: the binary is brew-owned, so background checks are off and the
# self-updater is refused by the `herdr` wrapper in ~/.zshrc -- upgrade
# with `brew upgrade herdr` like every other formula. See docs/herdr.md.
{{- $app := output (joinPath .chezmoi.sourceDir "scripts" "theme.py") "appearance" | fromJson -}}
{{- $mode := $app.mode -}}
{{- $lr := $app.light.roles -}}
{{- $dr := $app.dark.roles -}}
{{- $lt := $app.light.terminal -}}
{{- $dt := $app.dark.terminal -}}
{{- $tokens := list
       (list "panel_bg"    "bg")
       (list "sidebar_bg"  "bg_deep")
       (list "surface0"    "statusline")
       (list "surface1"    "surface")
       (list "overlay0"    "grey_dim")
       (list "overlay1"    "grey")
       (list "text"        "fg")
       (list "subtext0"    "fg_soft")
       (list "accent"      "blue")
       (list "mauve"       "purple")
       (list "teal"        "aqua")
       (list "peach"       "orange")
       (list "red"         "red")
       (list "green"       "green")
       (list "yellow"      "yellow")
       (list "blue"        "blue") -}}
{{- define "herdr-palette" -}}
{{- $p := index . "palette" -}} {{- $t := index . "terminal" -}} {{- $tk := index . "tokens" -}}
{{- range $tk }}{{ $k := index . 0 }}{{ $r := index . 1 }}
{{ $k }} = "{{ index $p $r }}"
{{- end }}
selection_bg = "{{ index $t "selection-background" }}"
{{- end }}

onboarding = false

[theme]
# Base theme "terminal": follow the host palette for anything the overrides
# below leave unset. Every hex here is a resolved role of the active themes
# -- the same single source as ghostty/nvim/pi/delta (no orphan hexes; the
# smoke test's color step checks).
name = "terminal"
{{- if eq $mode "system" }}
auto_switch = true
dark_name = "terminal"
light_name = "terminal"

[theme.custom.light]{{- template "herdr-palette" dict "palette" $lr "terminal" $lt "tokens" $tokens }}

[theme.custom.dark]{{- template "herdr-palette" dict "palette" $dr "terminal" $dt "tokens" $tokens }}
{{- else }}
auto_switch = false

[theme.custom]{{- if eq $mode "light" }}{{- template "herdr-palette" dict "palette" $lr "terminal" $lt "tokens" $tokens }}
{{- else }}{{- template "herdr-palette" dict "palette" $dr "terminal" $dt "tokens" $tokens }}
{{- end }}
{{- end }}

[update]
channel = "stable"
version_check = false
manifest_check = false
