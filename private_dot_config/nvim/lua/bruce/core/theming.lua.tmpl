{{- /* Everything here is resolved at apply time by scripts/ghostty-theme.py:
     the three settings from theme.toml (the repo root), the themes parsed
     and derived straight from Ghostty's own catalog -- so any theme
     `ghostty +list-themes` shows works, with nothing cached that can go
     stale. */ -}}
{{ $a := output (joinPath .chezmoi.sourceDir "scripts/ghostty-theme.py") "appearance" | trim | fromJson -}}
{{ $l := $a.light -}}
{{ $d := $a.dark -}}
-- theming.lua -- GENERATED at apply time from theme.toml (the three
-- settings, at the repo root) and Ghostty's theme catalog (via
-- scripts/ghostty-theme.py). Do not edit by hand: change theme.toml, then
-- `chezmoi apply`.
--
-- This is Neovim's single point of contact with the palette system. Static
-- modules read it instead of carrying generated bytes of their own:
--   core/appearance.lua   mode: system-follow vs pinned light/dark
--   colors/scheme.lua     the colorscheme, generated from the roles
--   plugins/ui (lualine)  statusline tables from the role palettes
return {
    mode = "{{ $a.mode }}", -- "system" | "light" | "dark"
    -- both themes' semantic roles and raw 16-color terminal palettes,
    -- keyed by the 'background' value
    palettes = {
        light = {
            terminal = { -- the theme's own palette 0-15, verbatim
                "{{ $l.terminal.palette_0 }}", "{{ $l.terminal.palette_1 }}",
                "{{ $l.terminal.palette_2 }}", "{{ $l.terminal.palette_3 }}",
                "{{ $l.terminal.palette_4 }}", "{{ $l.terminal.palette_5 }}",
                "{{ $l.terminal.palette_6 }}", "{{ $l.terminal.palette_7 }}",
                "{{ $l.terminal.palette_8 }}", "{{ $l.terminal.palette_9 }}",
                "{{ $l.terminal.palette_10 }}", "{{ $l.terminal.palette_11 }}",
                "{{ $l.terminal.palette_12 }}", "{{ $l.terminal.palette_13 }}",
                "{{ $l.terminal.palette_14 }}", "{{ $l.terminal.palette_15 }}",
            },
            bg = "{{ $l.roles.bg }}", bg_deep = "{{ $l.roles.bg_deep }}",
            surface = "{{ $l.roles.surface }}", fg = "{{ $l.roles.fg }}",
            fg_soft = "{{ $l.roles.fg_soft }}", fg_bright = "{{ $l.roles.fg_bright }}",
            grey = "{{ $l.roles.grey }}", grey_dim = "{{ $l.roles.grey_dim }}",
            grey_neutral = "{{ $l.roles.grey_neutral }}", grey_soft = "{{ $l.roles.grey_soft }}",
            red = "{{ $l.roles.red }}", orange = "{{ $l.roles.orange }}",
            yellow = "{{ $l.roles.yellow }}", green = "{{ $l.roles.green }}",
            aqua = "{{ $l.roles.aqua }}", blue = "{{ $l.roles.blue }}",
            purple = "{{ $l.roles.purple }}",
            tint_green = "{{ $l.roles.tint_green }}", tint_red = "{{ $l.roles.tint_red }}",
            statusline = "{{ $l.roles.statusline }}",
            statusline_accent = "{{ $l.roles.statusline_accent }}",
            statusline_fg = "{{ $l.roles.statusline_fg }}",
            on_accent = "{{ $l.roles.on_accent }}",
            mode_red = "{{ $l.roles.mode_red }}", mode_green = "{{ $l.roles.mode_green }}",
            mode_yellow = "{{ $l.roles.mode_yellow }}", mode_blue = "{{ $l.roles.mode_blue }}",
            mode_purple = "{{ $l.roles.mode_purple }}",
        },
        dark = {
            terminal = { -- the theme's own palette 0-15, verbatim
                "{{ $d.terminal.palette_0 }}", "{{ $d.terminal.palette_1 }}",
                "{{ $d.terminal.palette_2 }}", "{{ $d.terminal.palette_3 }}",
                "{{ $d.terminal.palette_4 }}", "{{ $d.terminal.palette_5 }}",
                "{{ $d.terminal.palette_6 }}", "{{ $d.terminal.palette_7 }}",
                "{{ $d.terminal.palette_8 }}", "{{ $d.terminal.palette_9 }}",
                "{{ $d.terminal.palette_10 }}", "{{ $d.terminal.palette_11 }}",
                "{{ $d.terminal.palette_12 }}", "{{ $d.terminal.palette_13 }}",
                "{{ $d.terminal.palette_14 }}", "{{ $d.terminal.palette_15 }}",
            },
            bg = "{{ $d.roles.bg }}", bg_deep = "{{ $d.roles.bg_deep }}",
            surface = "{{ $d.roles.surface }}", fg = "{{ $d.roles.fg }}",
            fg_soft = "{{ $d.roles.fg_soft }}", fg_bright = "{{ $d.roles.fg_bright }}",
            grey = "{{ $d.roles.grey }}", grey_dim = "{{ $d.roles.grey_dim }}",
            grey_neutral = "{{ $d.roles.grey_neutral }}", grey_soft = "{{ $d.roles.grey_soft }}",
            red = "{{ $d.roles.red }}", orange = "{{ $d.roles.orange }}",
            yellow = "{{ $d.roles.yellow }}", green = "{{ $d.roles.green }}",
            aqua = "{{ $d.roles.aqua }}", blue = "{{ $d.roles.blue }}",
            purple = "{{ $d.roles.purple }}",
            tint_green = "{{ $d.roles.tint_green }}", tint_red = "{{ $d.roles.tint_red }}",
            statusline = "{{ $d.roles.statusline }}",
            statusline_accent = "{{ $d.roles.statusline_accent }}",
            statusline_fg = "{{ $d.roles.statusline_fg }}",
            on_accent = "{{ $d.roles.on_accent }}",
            mode_red = "{{ $d.roles.mode_red }}", mode_green = "{{ $d.roles.mode_green }}",
            mode_yellow = "{{ $d.roles.mode_yellow }}", mode_blue = "{{ $d.roles.mode_blue }}",
            mode_purple = "{{ $d.roles.mode_purple }}",
        },
    },
}
