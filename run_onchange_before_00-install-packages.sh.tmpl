#!/usr/bin/env bash
# Install the external tools the Neovim config depends on.
#
# chezmoi re-runs this script whenever its rendered contents change, so adding a
# package to the list below is enough to get it installed on every machine the
# next time `chezmoi apply` runs.

set -euo pipefail

# ripgrep         telescope live_grep (<leader>fs)
# node            markdown-preview.nvim's preview server, npm-based LSP servers
# ipython         iron.nvim's Python REPL (<leader>`)
# tree-sitter-cli nvim-treesitter (main branch) builds parsers with it
PACKAGES=(ripgrep node ipython tree-sitter-cli)

if command -v brew >/dev/null 2>&1; then
    missing=()
    for pkg in "${PACKAGES[@]}"; do
        brew list --formula "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo "installing with brew: ${missing[*]}"
        brew install "${missing[@]}"
    fi
{{- if eq .chezmoi.os "linux" }}
elif command -v dnf >/dev/null 2>&1; then
    # Fedora package names differ from Homebrew's.
    echo "brew not found; installing with dnf"
    sudo dnf install -y ripgrep nodejs python3-ipython
    echo "note: tree-sitter-cli is not packaged for dnf; install it with cargo or brew"
{{- end }}
else
    echo "no supported package manager found; install manually: ${PACKAGES[*]}" >&2
fi
