{{- $piWrap := output (joinPath .chezmoi.sourceDir "scripts" "theme.py") "--setting" "tmux_wrap" | trim -}}
{{- $piTheme := output (joinPath .chezmoi.sourceDir "scripts" "theme.py") "--setting" "theme" | trim -}}
# ~/.zshrc — the interactive shell config, read by EVERY terminal on this
# machine: Ghostty, Terminal.app, iTerm2, and SSH sessions alike. Managed by
# chezmoi (dot_zshrc.tmpl in the dotfiles repo) — edit it there, not here.
# Two conditional renders: tmux_wrap = "off" becomes a PI_TMUX_WRAP
# default in the pi section, and a pinned theme renders PI_THEME_PINNED
# so the wrapper never injects --use-theme over the pin. Everything else
# is static. Login-shell PATH lives in ~/.zprofile; this file is the
# interactive half: options, history, completion, keybindings, shell
# integrations (fzf, autosuggestions, syntax highlighting), aliases,
# secrets, prompt.

# --- PATH -------------------------------------------------------------------
# Login shells get Homebrew from ~/.zprofile; this re-establishes it for
# non-login interactive shells (nested zsh, emulators that skip .zprofile).
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Tools that install to ~/.local/bin (uv, remctl). Guarded so machines
# without it stay quiet.
[[ -x $HOME/.local/bin/env ]] && . "$HOME/.local/bin/env"

# Version managers, if used. Uncomment what applies.
# eval "$(mise activate zsh)"
# eval "$(pyenv init -)"

# Guarded rather than a bare `export EDITOR=nvim`: on a machine where Neovim
# is not installed yet, an unresolvable EDITOR breaks `git commit`, `crontab -e`
# and anything else that shells out to it.
if command -v nvim >/dev/null; then
  export EDITOR=nvim
  export VISUAL=nvim
else
  export EDITOR=vim
  export VISUAL=vim
fi

# --- History ----------------------------------------------------------------
# ONE history file for every terminal and every SSH session, deliberately
# $HOME-pinned so nothing can quietly fork history off to a second file
# again. SHARE_HISTORY merges sessions live: a command entered in Ghostty is
# immediately on Ctrl-R in iTerm2 (and vice versa).
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY SHARE_HISTORY INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY

# --- Shell behavior ---------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS NO_BEEP
setopt EXTENDED_GLOB NO_NOMATCH   # NO_NOMATCH: unmatched globs pass through
                                  # unchanged instead of erroring, as in bash

# --- Completion -------------------------------------------------------------
# Hand-written completions (e.g. remctl), if present.
[[ -d $HOME/.zsh/completions ]] && fpath=($HOME/.zsh/completions $fpath)

autoload -Uz compinit
# compinit consults compaudit and y/n-PROMPTS when it finds insecure fpath
# dirs — owned by neither root nor $USER; some CI runner images ship
# exactly that. On a tty that is a fine, deliberate question; with no tty
# (CI, -c shells, scripted ssh) the prompt cannot be answered and compinit
# aborts silently: no completions, no dump file, no error shown. Keep the
# audit for interactive shells, skip it where it can only break things.
if [[ -t 0 ]]; then
  compinit -d "$HOME/.zcompdump"
else
  compinit -d "$HOME/.zcompdump" -u
fi
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{8}%d%f'

# --- Keybindings ------------------------------------------------------------
bindkey -e   # emacs mode; ctrl-a/ctrl-e/ctrl-k match macOS text fields

# Up/Down search history using what has already been typed
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# Option+Left / Option+Right word jumping works in Ghostty out of the box,
# and iTerm2/Terminal.app send compatible sequences; emacs mode binds
# ESC-b / ESC-f automatically. No macos-option-as-alt setting is needed.

# Option+forward-delete (fn+Delete) kills the NEXT word, matching pi's
# alt+delete. Ghostty encodes the modifier as a CSI parameter (esc [ 3 ;
# 3 ~); Esc-prefix terminals send esc esc [ 3 ~ instead. Plain
# forward-delete -- which stock emacs mode leaves unbound on this
# system -- deletes one character.
bindkey '^[[3;3~' kill-word
bindkey '^[^[[3~' kill-word
bindkey '^[[3~' delete-char

# --- Shell integrations ------------------------------------------------------
# The three quality-of-life pieces, each guarded by file existence so a
# machine without the formula (CI, a fresh install mid-setup) stays quiet
# -- same idea as the fastfetch guard below. Both blocks below source
# AFTER compinit, which fzf's completion.zsh expects; the third,
# syntax highlighting, is sourced at the very end of this file.
# HOMEBREW_PREFIX is exported by `brew shellenv` (top of this file for
# non-login shells, ~/.zprofile for login ones); probe `brew --prefix`
# as a fallback for shells where neither ran -- it answers the Apple
# Silicon (/opt/homebrew) and Intel (/usr/local) prefixes alike.
if [[ -z ${HOMEBREW_PREFIX:-} ]] && command -v brew >/dev/null 2>&1; then
  HOMEBREW_PREFIX="$(command brew --prefix)"
fi

# fzf: fuzzy Ctrl-R (history), Ctrl-T (files into the command line),
# Alt-C (directories). fzf replaces the Ctrl-R widget only -- the
# up/down beginning-search binds above are different keys; both survive.
[[ -r $HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh ]] \
  && source $HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh
[[ -r $HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh ]] \
  && source $HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh

# zsh-autosuggestions: fish-style ghost text from history. Indexed color
# 8 -- ghost text follows the terminal palette like ps1.zsh, never a hex
# (the color-system rule). Suggestions read the in-memory history, so
# SHARE_HISTORY makes other terminals' commands suggestable live; the
# one-file history design needs no changes.
if [[ -r $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
  source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  # Suggestion shortcuts, everything else stock. In Ghostty the
  # ctrl-modified Enters arrive in the modifyOtherKeys CSI form
  # (esc[27;N;13~, N = 1 + ctrl 4 + alt 2) -- legacy bytes cannot express
  # ctrl on enter -- and OUTSIDE Ghostty ctrl+enter is byte-identical to
  # plain enter, so these chords are Ghostty-scoped by nature: ctrl+enter
  # runs the suggestion as-is, ctrl+option+enter accepts it without
  # running. The csi-u twins (esc[13;5u / esc[13;7u) cover tmux, whose
  # extended-keys csi-u forwarding re-encodes the chords for panes.
  # Everything else keeps its stock behavior -- including the unbound
  # shift variants (esc[27;2;13~ / esc[27;4;13~), which in Ghostty
  # self-insert literal digits if pressed; an accepted trade, do not
  # bind them without revisiting the "everything else stock" call. The
  # replaced bytes were all unbound stock, nothing displaced. Inside
  # this guard because the plugin's widgets don't exist without the
  # formula.
  #
  # ZSH_AUTOSUGGEST_IGNORE_WIDGETS is load-bearing for run-suggestion:
  # the plugin's deferred rebinder (at the first prompt) wraps every user
  # widget in its "modify" action, which clears POSTDISPLAY before the
  # widget body runs -- without the exemption the guard below would
  # never see a suggestion. It must also stay BELOW the source line:
  # the plugin installs its default ignore list only when the variable
  # is unset, so hoisting this line above the source would silently drop
  # those defaults. autosuggest-accept needs no wrapper: it is the
  # plugin's own widget and already no-ops with no suggestion or a
  # mid-line cursor.
  ZSH_AUTOSUGGEST_IGNORE_WIDGETS+='run-suggestion'
  run-suggestion() {
    # Execute only a FULL suggestion with the cursor at the end; every
    # other state is a no-op -- never run a half-typed line.
    if [[ -n $POSTDISPLAY && $CURSOR -eq $#BUFFER ]]; then
      zle autosuggest-execute
    fi
  }
  zle -N run-suggestion
  bindkey '^[[27;5;13~' run-suggestion       # ctrl+enter: accept and run
  bindkey '^[[13;5u' run-suggestion          # same, via tmux csi-u forwarding
  bindkey '^[[27;7;13~' autosuggest-accept   # ctrl+option+enter: accept only
  bindkey '^[[13;7u' autosuggest-accept      # same, via tmux csi-u forwarding
fi

# --- Aliases ----------------------------------------------------------------
# Colorized ls: probe instead of assuming, so a GNU ls (coreutils) shadowing
# the stock BSD one still works -- they disagree on the flag (-G vs
# --color=auto; recent macOS ls happens to accept both).
if ls --color=auto . >/dev/null 2>&1; then
  _ls_color='--color=auto'
else
  _ls_color='-G'
fi
alias l="ls $_ls_color"
alias ls="ls $_ls_color"
alias ll="ls -lh $_ls_color"
alias la="ls -lhA $_ls_color"
unset _ls_color
alias grep='grep --color=auto'

# --- Clipboard --------------------------------------------------------------
# clipcopy / clippaste -- the oh-my-zsh clipboard commands, reimplemented
# for this repo's one platform instead of sourced from omz: macOS ships
# pbcopy/pbpaste with the OS, so omz's OSTYPE ladder collapses to nothing
# and the whole thing is ~15 lines we own. Same semantics, one deliberate
# simplification: an explicit file argument wins over a pipe when both
# are present ("cmd | clipcopy file" copies the file). They read and
# write the Mac's own pasteboard -- the same clipboard nvim's yanks use
# -- from every terminal and over SSH into the Mac alike; the other
# direction (onto the VIEWING device's clipboard over SSH) stays tmux's
# OSC 52 copy-mode job (docs/tmux.md).
#   <command> | clipcopy       copy stdin
#   clipcopy <file>            copy the file's contents
#   clippaste                  print the clipboard (redirect to save it)
clipcopy() {
  emulate -L zsh
  local file=$1
  if [[ -n $file ]]; then
    if [[ ! -r $file ]]; then
      print -u2 "clipcopy: not readable: $file"
      return 1
    fi
    pbcopy < "$file"
  elif [[ ! -t 0 ]]; then
    pbcopy
  else
    print -u2 "usage: <command> | clipcopy  |  clipcopy <file>"
    return 1
  fi
}

clippaste() {
  emulate -L zsh
  pbpaste
}

# --- pi ---------------------------------------------------------------------
# `pi` always starts a NEW conversation, wrapped in its own tmux session so
# it survives closing the terminal and can be rejoined from any device
# (a phone over SSH included). Rejoining is deliberately manual:
#
#   tmux attach -t <name>     # lands straight inside the running pi
#
# The session dies when pi exits, so `tmux ls` is exactly the live
# conversations -- nothing dangles. Naming: the project directory's
# basename ("chezmoi"), numbered siblings on collision ("chezmoi-2"), or
# the sanitized topic from `pi -n "auth refactor"` (which pi also keeps as
# its own session display name). From $HOME pi runs unwrapped -- a home
# directory is not a project name, and pi organizes its session store by
# cwd anyway.
#
# PI_TMUX_WRAP=never disables the wrapper (automation, debugging); =force
# bypasses the tty check (used by scripts/smoke-test.sh, which has no tty).
# The default comes from settings.toml at the repo root: tmux_wrap = "off"
# renders a PI_TMUX_WRAP=never default just below, so the machine-level
# env override still wins either way.
{{ if eq $piWrap "off" -}}
# settings.toml says tmux_wrap = "off": pi runs bare on this machine unless
# the environment says otherwise (PI_TMUX_WRAP=force wraps for one run).
: ${PI_TMUX_WRAP:=never}
{{ end -}}
{{ if ne $piTheme "system" -}}
# settings.toml pins theme = "{{ $piTheme }}": pi's settings.json carries the
# single dotfiles-{{ $piTheme }} theme. The wrapper below must not inject
# --use-theme either (the flag beats settings.json and would silently
# override the pin on a terminal that disagrees), so it never probes.
PI_THEME_PINNED="{{ $piTheme }}"
{{ end -}}
# Sanitize a tmux session name: lowercase, dashes for spaces/underscores,
# [a-z0-9-] only (tmux forbids ':' and '.'; keep it shell- and
# human-friendly). Prints the result; may be empty for hostile input.
__pi_tmux_name() {
  local s="${1:l}"
  s="${s//[_[:space:]]/-}"
  s="${s//[^a-z0-9-]/}"
  while [[ $s == *--* ]]; do s="${s//--/-}"; done
  printf '%s' "${${s#-}%-}"
}

# Which side of the dotfiles-{light,dark} pair this conversation runs.
# pi cannot ask the terminal itself once the wrapper puts it under tmux:
# its OSC 11 / CSI ?996n queries stop at the tmux layer, COLORFGBG never
# crosses SSH, and pi's fallback is "dark" -- so without this, every
# conversation rendered the dark pair no matter what the terminal in
# front of you actually looked like (most visible when SSH-ing from a
# light-mode machine: pi's conversation panels stayed dark). Here, before
# the session exists, the query travels the raw pipe -- SSH included --
# to the VIEWING terminal. Sets REPLY to light|dark (dark unless a reply
# proves otherwise -- pi's own fallback); returns nonzero if interrupted.
# Keystrokes that arrive during the exchange are stashed in __pi_typed
# (pi() re-injects them into the session), so the probe never eats
# typeahead; stdin+stdout must be the terminal itself (the wrapper's own
# guards ensure that in practice).
#
# The reply contract mirrors pi's own parser byte for byte:
#   CSI ? 996 n   ->  CSI ? 997 ; 1 n (dark) / CSI ? 997 ; 2 n (light)
#   OSC 11 query  ->  ESC ] 11 ; rgb:R/G/B | rgba:R/G/B/A | #RRGGBB |
#                    #RRRRGGGGBBBB (1-4 hex digits per channel, BEL- or
#                    ST-terminated), classified by pi's gamma-corrected
#                    luminance, >= 0.5 = light: the linearization step is
#                    what a naive /255 weighted average gets wrong on
#                    mid-tones (#999999 is dark). Echo is off during the
#                    exchange so the reply does not paint the screen.

# One channel of an OSC color reply, scaled pi's way: any-width hex
# digits -> 0..255 (round(v/max*255)). Sets REPLY; returns 1 on garbage.
__pi_hex255() {
  emulate -L zsh
  local h=$1
  [[ $h =~ '^[0-9a-f]+$' ]] || return 1
  local max=$(( 16 ** $#h - 1 ))
  (( max > 0 )) || return 1
  REPLY=$(( (16#$h * 255 + max / 2) / max ))
}

# Read one terminal query reply. $1: query bytes to send ('' = drain
# pass, sends nothing); $2: the reply prefix this call awaits ('' =
# consume anything reply-shaped, return nothing); $3: seconds to wait
# for the first byte (an SSH round trip, not just the inter-byte gap);
# $4: seconds between bytes of one reply burst. Bytes are classified as
# they arrive: an escape sequence matching the awaited prefix is the
# reply (REPLY, return 0); anything else that looks like a terminal
# report (CSI-? or OSC -- e.g. a late reply to the earlier query) is
# consumed and dropped, since re-injecting THAT into pi would type
# garbage; every other byte -- plain characters, arrow keys, pasted
# text -- is user typeahead, accumulated in __pi_typed and never eaten.
# Returns 1 when no reply completed (REPLY empty).
__pi_read_reply() {
  emulate -L zsh
  local query=$1 await=$2 tfirst=$3 trest=$4
  local c seq='' t=$tfirst
  local -i in_seq=0 n=0
  REPLY=''
  [[ -n $query ]] && print -n -- "$query"
  while (( n++ < 128 )) && IFS= read -r -k 1 -t $t c; do
    if (( ! in_seq )); then
      if [[ $c == $'\e' ]]; then
        seq=$c; in_seq=1; t=$trest
      else
        __pi_typed+=$c; t=$tfirst
      fi
      continue
    fi
    seq+=$c
    # A sequence is complete at: OSC BEL, OSC ST (ESC \), a CSI final
    # byte (0x40-0x7e, at least one byte after the '['), or a bare
    # ESC+key pair (alt-b, ESC o, ...) -- everything else is payload.
    # (Separate ifs, not one ||-chain: shell && and || bind with equal
    # precedence, so a chain would misparse. "$await" stays quoted --
    # the DSR prefix contains '[', which unquoted would parse as the
    # start of a bracket pattern class.)
    local -i done=0
    if [[ $c == $'\a' ]]; then done=1                            # OSC: BEL
    elif [[ ${seq[-2]} == $'\e' && $c == '\' ]]; then done=1     # OSC: ST
    elif (( ${#seq} > 2 )) && [[ ${seq[2]} == '[' && $c =~ '[@-~]' ]]; then done=1  # CSI final
    elif [[ ${seq[2]} != '[' && ${seq[2]} != ']' ]]; then done=1 # ESC + key
    fi
    if (( done )); then
      if [[ -n $await && $seq == "$await"* ]]; then
        REPLY=$seq
        return 0
      fi
      if [[ $seq != $'\e[?'* && $seq != $'\e]'* ]]; then
        __pi_typed+=$seq        # a keystroke, not a report: keep it
      fi
      seq=''; in_seq=0; t=$tfirst
    fi
  done
  # Half a sequence when the window lapsed: keep only a lone ESC (a
  # real keypress); ESC-plus-payload is a report fragment, and
  # re-injecting it into pi would type garbage.
  (( in_seq )) && [[ $seq == $'\e' ]] && __pi_typed+=$seq
  return 1
}

__pi_theme_side() {
  emulate -L zsh
  setopt localtraps
  local result='' saved reply val hex spec r g b
  local -a ch
  local -i interrupted=0 ok
  local -F vr vg vb lum
  REPLY=dark
  __pi_typed=''
  [[ -t 0 && -t 1 ]] || return 0
  saved=$(command stty -g 2>/dev/null) || return 0
  # Ctrl-C / kill during the probe window must not leave the tty raw:
  # the flag aborts the launch, the always block restores the settings.
  trap 'interrupted=1' INT TERM
  {
    command stty -echo -icanon 2>/dev/null
    # Scheme report first: one round trip, an exact answer where the
    # terminal supports it. A report naming an unknown scheme (or no
    # report at all) falls through to the background-color query.
    __pi_read_reply $'\e[?996n' $'\e[?997;' 1.0 0.15
    reply=$REPLY
    val=${reply##*;}          # '2n' / '1n' / '' -- last group wins, as in pi
    val=${val%n}
    [[ $val == 2 ]] && result=light
    [[ $val == 1 ]] && result=dark
    if [[ -z $result ]]; then
      # OSC 11 background color: the widely supported fallback.
      __pi_read_reply $'\e]11;?\a' $'\e]11;' 1.0 0.15
      reply=$REPLY
      val=${reply#$'\e]11;'}
      val=${val%$'\a'}
      [[ $val == *$'\e\\' ]] && val=${val[1,-3]}
      val=${val:l}
      ok=0
      if [[ $val == \#* ]]; then
        hex=${val#\#}
        if (( $#hex == 6 )); then
          r=$(( 16#${hex[1,2]} )); g=$(( 16#${hex[3,4]} )); b=$(( 16#${hex[5,6]} )); ok=1
        elif (( $#hex == 12 )); then
          ok=1
          __pi_hex255 ${hex[1,4]} && r=$REPLY || ok=0
          __pi_hex255 ${hex[5,8]} && g=$REPLY || ok=0
          __pi_hex255 ${hex[9,12]} && b=$REPLY || ok=0
        fi
      elif [[ $val == rgb:* || $val == rgba:* ]]; then
        spec=${val#rgb*:}
        ch=(${(s./.)spec})
        if (( $#ch >= 3 )); then
          ok=1
          __pi_hex255 $ch[1] && r=$REPLY || ok=0
          __pi_hex255 $ch[2] && g=$REPLY || ok=0
          __pi_hex255 $ch[3] && b=$REPLY || ok=0
        fi
      fi
      if (( ok )); then
        # pi's getRgbColorLuminance verbatim: linearize each sRGB
        # channel (the gamma step), then Rec.709 weights, >= 0.5 light.
        vr=$(( r / 255.0 ))
        if (( vr <= 0.03928 )); then vr=$(( vr / 12.92 )); else vr=$(( ((vr + 0.055) / 1.055) ** 2.4 )); fi
        vg=$(( g / 255.0 ))
        if (( vg <= 0.03928 )); then vg=$(( vg / 12.92 )); else vg=$(( ((vg + 0.055) / 1.055) ** 2.4 )); fi
        vb=$(( b / 255.0 ))
        if (( vb <= 0.03928 )); then vb=$(( vb / 12.92 )); else vb=$(( ((vb + 0.055) / 1.055) ** 2.4 )); fi
        lum=$(( 0.2126 * vr + 0.7152 * vg + 0.0722 * vb ))
        if (( lum >= 0.5 )); then result=light; else result=dark; fi
      fi
    fi
    # Straggler sweep: a reply still in flight when the windows lapsed
    # must be consumed here, not leak into the session tmux is about to
    # own (where it would type escape garbage into the conversation).
    __pi_read_reply '' '' 0.1 0.05
  } always {
    command stty "$saved" 2>/dev/null
    trap - INT TERM
  }
  (( interrupted )) && return 1
  # ${result:-dark}: a terminal that answered nothing keeps pi's own
  # fallback (and the drain pass above leaves REPLY empty when it ate
  # a straggler, so REPLY cannot carry the default through).
  REPLY=${result:-dark}
  return 0
}

pi() {
  emulate -L zsh
  local arg i name="" REPLY
  local __pi_typed=''
  local -i user_theme=0
  local -a a=("$@") quoted=()
  if [[ ${PI_TMUX_WRAP:-} == never ]]; then command pi "$@"; return; fi
  # One-shot invocations must never spawn a tmux server: the session would
  # flash the alternate screen and swallow the output when it dies. Flags
  # anywhere in argv, and pi's management subcommands, mean "just run it".
  # The -n/--name topic rides along in the same pass (passed to pi verbatim).
  # An explicit --use-theme is NOT one-shot (it is a normal interactive
  # run flag): the session still wraps, but the wrapper must not stack a
  # detected theme on top of the user's choice.
  for (( i=1; i<=${#a}; i++ )); do
    case "${a[i]}" in
      -h|--help|-v|--version|-p|--print|--mode|--mode=*|--list-models)
        command pi "$@"; return ;;
      -n|--name)    name="${a[i+1]:-}" ;;
      --name=*)     name="${${a[i]}#--name=}" ;;
      --use-theme|--use-theme=*) user_theme=1 ;;
    esac
  done
  case "${a[1]:-}" in
    install|remove|uninstall|update|list|config|auth) command pi "$@"; return ;;
  esac
  # No wrapping inside tmux, without the binary, off a tty, or from $HOME.
  if [[ -n ${TMUX:-} ]] || ! command -v tmux >/dev/null 2>&1 \
     || [[ $PWD == "$HOME" ]] \
     || { [[ ${PI_TMUX_WRAP:-} != force ]] && ( [[ ! -t 0 || ! -t 1 ]] ) }; then
    command pi "$@"; return
  fi
  # Session name: the sanitized topic, else the sanitized project dirname.
  # Only a topic that survives sanitization earns the explicit behavior
  # (refuse when already live); a missing/empty/non-ASCII topic is simply
  # not a topic, and the project name is used.
  local base="$(__pi_tmux_name "${name:-${PWD:t}}")" explicit=0
  if [[ -n $name && -n $base ]]; then
    explicit=1
  else
    base="$(__pi_tmux_name "${PWD:t}")"
    [[ -z $base ]] && { command pi "$@"; return; }   # pathological dirname
  fi
  # An explicitly requested topic that is already live is a mistake, not a
  # collision -- say how to rejoin instead of silently minting "topic-2".
  local sess="$base" n=2
  if (( explicit )) && command tmux has-session -t "=$base" 2>/dev/null; then
    print -u2 "pi: tmux session \"$base\" is already live -- rejoin: tmux attach -t $base"
    return 1
  fi
  while command tmux has-session -t "=$sess" 2>/dev/null; do
    sess="${base}-${n}"; (( n++ ))
  done
  # Theme side: decided here, passed explicitly -- inside the session pi
  # cannot see the terminal anymore. A pinned settings.toml theme never
  # probes (pi's settings.json already names the one theme, and
  # --use-theme would override the pin); a user-supplied --use-theme
  # stands exactly as given.
  local -a theme_args=()
  if (( ! user_theme )) && [[ -z ${PI_THEME_PINNED:-} ]]; then
    __pi_theme_side || return        # interrupted mid-probe: abort quietly
    theme_args=(--use-theme "dotfiles-$REPLY")
  fi
  for arg in ${theme_args} "$@"; do quoted+=("${(q)arg}"); done
  print -r -- "pi: tmux session \"$sess\" (detach Ctrl-b d; rejoin: tmux attach -t $sess)"
  if (( ${#__pi_typed} )); then
    # Keystrokes that arrived while the probe held the terminal: deliver
    # them to the conversation they were aimed at. new-session's client
    # blocks until the session ends, so mint detached, feed, then attach.
    command tmux new-session -d -s "$sess" "command pi ${(j: :)quoted}"
    command tmux send-keys -t "$sess" -l -- "$__pi_typed"
    command tmux attach -t "$sess"
  else
    command tmux new-session -s "$sess" "command pi ${(j: :)quoted}"
  fi
}

# --- Secrets ----------------------------------------------------------------
# API keys and tokens (GitHub, Anthropic, ...) live in ~/.zsh/secrets.zsh —
# outside this repo on purpose; see .chezmoiignore. Optional file: machines
# with no secrets just skip this.
[[ -r $HOME/.zsh/secrets.zsh ]] && source $HOME/.zsh/secrets.zsh

# --- Prompt -----------------------------------------------------------------
source "$HOME/.config/zsh/ps1.zsh"

# --- Greeting ---------------------------------------------------------------
# Banner on new interactive shells. No p10k-style instant prompt exists
# anymore, so console output here is not captured or discarded.
if [[ -o interactive ]] && command -v fastfetch >/dev/null; then
  fastfetch
fi

# --- Syntax highlighting -----------------------------------------------------
# LAST on purpose and must stay that way: zsh-syntax-highlighting wraps
# ZLE widgets at load time, so every other widget binding above (the
# up/down history search, fzf's Ctrl-R) has to exist first or it wraps a
# stale copy. Invalid commands color red before Enter, valid ones green.
[[ -r $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] \
  && source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
