#!/bin/sh
# delta-theme -- delta with syntax colors matching the configured look.
#
# Used as git's pager and lazygit's diff renderer; every flag is passed
# through. The light/dark mode is baked in by chezmoi from settings.toml (the
# repo root) at apply time:
#
#   mode   theme = "light" or "dark" pins the appearance; "system" follows
#          the OS, like Ghostty's theme line and Neovim's OS-following
#          'background' (dark syntax on a light terminal and vice versa
#          are unreadable). Detection: `defaults read -g
#          AppleInterfaceStyle` prints "Dark" and exits 0 in dark mode; in
#          light mode the key does not exist and it exits nonzero.
#   theme  always "none": bat syntax colors are disabled, so diffs render
#          in the terminal's own 16-color palette -- cohesive with
#          whatever Ghostty theme is active, by construction.

MODE='{{ output (joinPath .chezmoi.sourceDir "scripts/ghostty-theme.py") "--setting" "theme" | trim }}'

case "$MODE" in
light|dark) mode=$MODE ;;
*)
    mode=dark
    defaults read -g AppleInterfaceStyle >/dev/null 2>&1 || mode=light
    ;;
esac

if [ "$mode" = dark ]; then
    exec delta --dark --syntax-theme none "$@"
else
    exec delta --light --syntax-theme none "$@"
fi
